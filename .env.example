# .env

# === PostgreSQL ===
POSTGRES_DB=ppe_violations_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=your_password

# === RabbitMQ ===
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# === Application Ports ===
# Порт, на котором будет доступен API сервер для Frontend
API_SERVER_PORT=8888
# Порт для веб-интерфейса RabbitMQ (для отладки)
RABBITMQ_MANAGEMENT_PORT=15672

# Включаем режим Triton
DETECTION_MODE=TRITON

# Адрес сервера (совпадает с именем сервиса в docker-compose)
TRITON_URL=triton:8000